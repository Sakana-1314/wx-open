# 容器部署的环境变量样例：cp deploy/.env.docker.example deploy/.env 后按需修改。
# 字段含义与 server/.env.example 完全一致，这里只列容器部署必须显式给出的项。

# ---- 公网与端口 ----
PUBLIC_BASE_URL=https://platform.example.com
# 宿主机暴露给 web 容器的端口（nginx :80）
WEB_PORT=8080
# 后端容器端口在宿主机上的回环映射（默认只给本机调试用）
SERVER_PORT=8091

# ---- 数据库（外部 MySQL / MariaDB，不在 compose 内）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wxplatform
DB_PASSWORD=wxplatform_dev_password
DB_NAME=wx_platform

# ---- 平台自身登录（必填）----
JWT_SECRET=please-change-me-to-a-long-random-string
ADMIN_PASSWORD=admin123456

# ---- 第三方平台凭据（开放平台 → 管理中心 → 第三方平台 → 详情）----
WX_COMPONENT_APPID=
WX_COMPONENT_APPSECRET=
WX_COMPONENT_VERIFY_TOKEN=
WX_COMPONENT_ENCODING_AES_KEY=
WX_COMPONENT_ENCODING_AES_KEY_PREV=

# 落库敏感值加密密钥（base64 的 32 字节；留空则由 JWT_SECRET 派生）
SECRET_ENC_KEY=

# ---- 可选调优 ----
WX_MAX_QPS=8
JOB_CONCURRENCY=3
JOB_MAX_ATTEMPTS=3
LOG_RETENTION_DAYS=30
