# 微信第三方平台管理平台：后端环境变量示例
# 复制为 server/.env 并按需修改。JWT_SECRET 与 ADMIN_PASSWORD 必填，缺失时服务拒绝启动。

# ---- 服务 ----
SERVER_PORT=8091
# 公网回调基址：必须与开放平台后台填写的域名一致，且回调地址要能被微信访问（https 对应 443）
PUBLIC_BASE_URL=https://your-domain.example.com

# ---- 数据库（MySQL / MariaDB）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wxplatform
DB_PASSWORD=wxplatform_dev_password
DB_NAME=wx_platform

# ---- 平台自身登录 ----
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_TOKEN_TTL_MINUTES=1440
ADMIN_PASSWORD=admin123456
# 登录限流（防公网暴力破解）
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_SECONDS=300

# ---- 第三方平台凭据（开放平台 → 管理中心 → 第三方平台 → 详情）----
# 未配置时服务仍可启动，但无法调用微信接口；概览页会给出「未配置」提示。
WX_COMPONENT_APPID=
WX_COMPONENT_APPSECRET=
# 「消息校验 Token」（后台开发资料里填写的那串）
WX_COMPONENT_VERIFY_TOKEN=
# 「消息加解密 Key」：固定 43 个字符，只含字母与数字
WX_COMPONENT_ENCODING_AES_KEY=
# 可选：上一次的加解密 Key（轮换期间同时保留，当前 Key 解不开时回退尝试）
WX_COMPONENT_ENCODING_AES_KEY_PREV=

# 落库敏感值（authorizer_refresh_token）的加密密钥：base64 编码的 32 字节
# 生成方式：head -c 32 /dev/urandom | base64
# 留空则由 JWT_SECRET 派生（会打印提示，生产建议显式配置）
SECRET_ENC_KEY=

# ---- 微信 API 调用 ----
WX_API_BASE=https://api.weixin.qq.com
WX_REQUEST_TIMEOUT_SECONDS=15
# 全局调用速率上限（QPS），避免撞频次限制
WX_MAX_QPS=8

# ---- 批量作业引擎 ----
# 并发线程数（同一小程序始终串行，避免 9402202）
JOB_CONCURRENCY=3
# 单个子项最大尝试次数（指数退避）
JOB_MAX_ATTEMPTS=3
# 日志保留天数（api_call_logs / callback_events 定期清理）
LOG_RETENTION_DAYS=30
# 上传代码后等待隐私检测任务结束的最长时间（秒），超时则该项失败并提示
PRIVACY_CHECK_MAX_WAIT_SECONDS=600
# 审核结果最长等待时间（秒），默认 7 天
AUDIT_RESULT_MAX_WAIT_SECONDS=604800

# ---- 本地开发：用内置模拟微信服务端（无需真实凭据）----
# 1 启用后 WX_API_BASE 会被指向内置 mock；同时可用 MOCK_WX_FAIL_RATE 注入随机失败
MOCK_WX=0
MOCK_WX_FAIL_RATE=0
